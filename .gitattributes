# Normalise line endings so a clone behaves the same on every platform.
# Git's core.autocrlf then has nothing to rewrite.

# Default: store as LF, check out as LF.
* text=auto eol=lf

# Windows batch files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts work with either; keep them LF for clean diffs.
*.ps1 text eol=lf
*.psm1 text eol=lf

# Binary
*.png binary
*.ico binary
*.exe binary
